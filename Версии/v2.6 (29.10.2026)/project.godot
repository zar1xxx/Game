; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="В погоне за бензином"
config/description="Бесконечная гонка по вечернему городу: уворачивайтесь от машин и собирайте бензин."
config/version="2.6"
run/main_scene="res://scenes/MainMenu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

SaveManager="*res://scripts/SaveManager.gd"
Missions="*res://scripts/Missions.gd"
Achievements="*res://scripts/Achievements.gd"
MobileInput="*res://scripts/MobileInput.gd"
Sound="*res://scripts/Sound.gd"
Transition="*res://scripts/Transition.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme.tres"

[input_devices]

sensors/enable_accelerometer=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0901961, 0.101961, 0.141176, 1)
